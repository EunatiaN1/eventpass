# Environment Mode (keep DEBUG=false and RELOAD=false in production)
ENVIRONMENT=production
DEBUG=false
RELOAD=false

# Supabase (Backend-only service role key — NEVER expose in frontend/mobile)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Backend JWT Signing Secret (minimum 32 random bytes in production)
JWT_SECRET=replace-with-a-cryptographically-random-32-byte-secret

# Strict CORS Allowlist (JSON list; never use ["*"])
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:8081","https://eventpass.co.za"]

# Fiat Payment Providers (Sandbox / Test Secrets)
PAYFAST_SECRET=your-payfast-passphrase-or-hmac-secret
PAYSTACK_SECRET=your-paystack-secret-key

# Passwordless email OTP delivery (Resend; use a verified sender/domain)
RESEND_API_KEY=re_your_resend_api_key
AUTH_FROM_EMAIL=EventPass <login@your-verified-domain.com>

# x402 Agent Payment Rail & Solana Devnet
X402_PAY_TO_ADDRESS=YourSolanaDevnetReceivingWalletAddress
X402_FACILITATOR_URL=https://x402.org/facilitator
ZAR_TO_USDC_RATE=0.055
# Never commit a real private key; inject via secret manager / KMS in production
SOLANA_PRIVATE_KEY=
